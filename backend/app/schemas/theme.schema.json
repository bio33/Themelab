{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThemeLab theme manifest v1 — proposed import contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "palette": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "background",
            "foreground",
            "accent"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "palette"
      ],
      "additionalProperties": false
    },
    "generation_policy": {
      "type": "object",
      "properties": {
        "phone_live_required": {
          "const": true
        },
        "watch_live_required": {
          "const": true
        },
        "fetch_missing_optional_components": {
          "const": false
        }
      },
      "required": [
        "phone_live_required",
        "watch_live_required",
        "fetch_missing_optional_components"
      ],
      "additionalProperties": false
    },
    "phone": {
      "type": "object",
      "properties": {
        "live_wallpaper": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "const": "video/mp4"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "loop": {
              "const": true
            },
            "audio": {
              "const": false
            }
          },
          "required": [
            "path",
            "mime_type",
            "sha256",
            "width",
            "height",
            "duration_seconds",
            "fps",
            "loop",
            "audio"
          ],
          "additionalProperties": false
        },
        "static_wallpaper": {
          "$ref": "#/$defs/asset"
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "default_enabled": {
                "type": "boolean"
              },
              "availability": {
                "enum": [
                  "suggested",
                  "bundled",
                  "external_reference"
                ]
              },
              "apply_mode": {
                "enum": [
                  "automatic_if_supported",
                  "user_action",
                  "provider_specific",
                  "manual"
                ]
              },
              "provider": {
                "type": "object",
                "properties": {
                  "platform": {
                    "enum": [
                      "android_appwidget",
                      "wear_os_complication",
                      "wear_os_tile"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strategy": {
                    "const": "discover_on_device"
                  },
                  "component": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "platform",
                  "category",
                  "strategy"
                ],
                "additionalProperties": false
              },
              "style": {
                "type": "object"
              },
              "dependency_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "placement": {
                "type": "object"
              },
              "preset_asset": {
                "$ref": "#/$defs/asset"
              }
            },
            "required": [
              "id",
              "label",
              "category",
              "default_enabled",
              "availability",
              "apply_mode",
              "provider"
            ],
            "additionalProperties": false
          }
        },
        "layout": {
          "type": "object",
          "description": "Adapter-specific optional fields. Adapter must validate these before application."
        },
        "icons": {
          "type": "object",
          "description": "Adapter-specific optional fields. Adapter must validate these before application."
        },
        "typography": {
          "type": "object",
          "description": "Adapter-specific optional fields. Adapter must validate these before application."
        },
        "lock_screen": {
          "type": "object",
          "description": "Adapter-specific optional fields. Adapter must validate these before application."
        },
        "sounds": {
          "type": "object",
          "description": "Adapter-specific optional fields. Adapter must validate these before application."
        },
        "system_style": {
          "type": "object",
          "description": "Adapter-specific optional fields. Adapter must validate these before application."
        }
      },
      "required": [
        "live_wallpaper"
      ],
      "additionalProperties": false
    },
    "watch": {
      "type": "object",
      "properties": {
        "live_background": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "enum": [
                "image/webp",
                "image/gif"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "loop": {
              "const": true
            },
            "audio": {
              "const": false
            }
          },
          "required": [
            "path",
            "mime_type",
            "sha256",
            "width",
            "height",
            "duration_seconds",
            "fps",
            "loop",
            "audio"
          ],
          "additionalProperties": false
        },
        "static_background": {
          "$ref": "#/$defs/asset"
        },
        "preview_video": {
          "$ref": "#/$defs/asset"
        },
        "clock": {
          "type": "object",
          "description": "Adapter-specific optional fields. Adapter must validate these before application."
        },
        "complication_slots": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "slot_id": {
                "type": "integer",
                "minimum": 1
              },
              "bounds": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "supported_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "SHORT_TEXT",
                    "LONG_TEXT",
                    "MONOCHROMATIC_IMAGE",
                    "SMALL_IMAGE",
                    "RANGED_VALUE",
                    "GOAL_PROGRESS",
                    "WEIGHTED_ELEMENTS",
                    "EMPTY"
                  ]
                }
              },
              "default_enabled": {
                "type": "boolean"
              },
              "default_category": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provider": {
                      "type": "object",
                      "properties": {
                        "platform": {
                          "enum": [
                            "android_appwidget",
                            "wear_os_complication",
                            "wear_os_tile"
                          ]
                        },
                        "category": {
                          "type": "string",
                          "minLength": 1
                        },
                        "strategy": {
                          "const": "discover_on_device"
                        },
                        "component": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "platform",
                        "category",
                        "strategy"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "category",
                    "label",
                    "provider"
                  ],
                  "additionalProperties": false
                }
              },
              "style": {
                "type": "object"
              },
              "apply_mode": {
                "enum": [
                  "user_action",
                  "provider_specific"
                ]
              },
              "availability": {
                "enum": [
                  "suggested",
                  "bundled",
                  "external_reference"
                ]
              }
            },
            "required": [
              "id",
              "slot_id",
              "bounds",
              "supported_types",
              "default_enabled",
              "default_category",
              "options",
              "style",
              "apply_mode",
              "availability"
            ],
            "additionalProperties": false
          }
        },
        "tiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "default_enabled": {
                "type": "boolean"
              },
              "availability": {
                "enum": [
                  "suggested",
                  "bundled",
                  "external_reference"
                ]
              },
              "apply_mode": {
                "enum": [
                  "automatic_if_supported",
                  "user_action",
                  "provider_specific",
                  "manual"
                ]
              },
              "provider": {
                "type": "object",
                "properties": {
                  "platform": {
                    "enum": [
                      "android_appwidget",
                      "wear_os_complication",
                      "wear_os_tile"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strategy": {
                    "const": "discover_on_device"
                  },
                  "component": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "platform",
                  "category",
                  "strategy"
                ],
                "additionalProperties": false
              },
              "style": {
                "type": "object"
              },
              "dependency_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "placement": {
                "type": "object"
              },
              "preset_asset": {
                "$ref": "#/$defs/asset"
              }
            },
            "required": [
              "id",
              "label",
              "category",
              "default_enabled",
              "availability",
              "apply_mode",
              "provider"
            ],
            "additionalProperties": false
          }
        },
        "aod": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "minimal_clock",
                "static_artwork"
              ]
            },
            "animate": {
              "const": false
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "asset": {
              "$ref": "#/$defs/asset"
            }
          },
          "required": [
            "mode",
            "animate"
          ],
          "additionalProperties": false
        },
        "face_package": {
          "type": "object",
          "description": "Adapter-specific optional fields. Adapter must validate these before application."
        }
      },
      "required": [
        "live_background"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Adapter-specific optional fields. Adapter must validate these before application."
      }
    },
    "previews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "extensions": {
      "type": "object",
      "description": "Adapter-specific optional fields. Adapter must validate these before application."
    }
  },
  "required": [
    "schema_version",
    "theme",
    "generation_policy",
    "phone",
    "watch"
  ],
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loop": {
          "type": "boolean"
        },
        "audio": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "mime_type"
      ],
      "additionalProperties": false
    }
  }
}
